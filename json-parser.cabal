cabal-version: 3.0

name: json-parser
version: 0.1.0.0

library
  default-language: Haskell2010
  hs-source-dirs: src

  ghc-options: -Wall

  exposed-modules:
    Data.Json

  build-depends:
    base ^>=4.20,
    bytestring ^>=0.12,
    internal,
    megaparsec ^>=9.7,
    text ^>=2.1

library internal
  default-language: Haskell2010
  hs-source-dirs: lib

  ghc-options: -Wall

  exposed-modules:
    Internal.Data.Json
    Internal.Text.Parser

  build-depends:
    base ^>=4.20,
    megaparsec ^>=9.7,
    text ^>=2.1

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests

  type: exitcode-stdio-1.0
  main-is: Spec.hs

  ghc-options: -Wall

  other-modules:
    Test.Internal.Text.ParserSpec

  build-depends:
    base ^>=4.20,
    bytestring ^>=0.12,
    directory ^>=1.3,
    filepath ^>=1.5,
    hspec ^>=2.11,
    hspec-megaparsec ^>=2.2,
    internal,
    megaparsec ^>=9.7,
    text ^>=2.1

  build-tool-depends:
    hspec-discover:hspec-discover ^>=2.11
