cabal-version: 3.0

name: json-parser
version: 0.1.0.0

synopsis: A JSON parser compliant with RFC 8259
description:
  A JSON parser, compliant with <https://www.rfc-editor.org/info/rfc8259/ RFC 8259>,
  which parses JSON into a @Json@ data structure.

  @Json@ values can be pretty-printed to @Text@ or a file.

license: BSD-3-Clause
license-file: LICENSE

author: Dwayne Crooks
maintainer: maintainer@dwaynecrooks.com

category: Text, JSON

extra-doc-files:
  README.md

source-repository head
  type: git
  location: https://github.com/dwayne/hs-json-parser

library
  default-language: Haskell2010
  hs-source-dirs: src

  ghc-options: -Wall

  exposed-modules:
    Data.Json

  build-depends:
    base ^>=4.20,
    bytestring ^>=0.12,
    internal,
    megaparsec ^>=9.7,
    scientific ^>=0.3,
    text ^>=2.1

library internal
  default-language: Haskell2010
  hs-source-dirs: lib

  ghc-options: -Wall

  exposed-modules:
    Internal.Data.Json
    Internal.Text.Parser
    Internal.Text.Printer

  build-depends:
    base ^>=4.20,
    megaparsec ^>=9.7,
    text ^>=2.1

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests
  main-is: Spec.hs
  type: exitcode-stdio-1.0

  ghc-options: -Wall

  other-modules:
    Test.Internal.Text.ParserSpec
    Test.Internal.Text.PrinterSpec

  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    hspec,
    hspec-megaparsec,
    internal,
    megaparsec,
    text

  build-tool-depends:
    hspec-discover:hspec-discover
