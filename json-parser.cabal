cabal-version: 3.0

name: json-parser
version: 0.1.0.0

library
  default-language: Haskell2010
  hs-source-dirs: src

  ghc-options: -Wall

  exposed-modules:
    Data.Json

  build-depends:
    base,
    bytestring,
    internal,
    megaparsec,
    text

library internal
  default-language: Haskell2010
  hs-source-dirs: lib

  ghc-options: -Wall

  exposed-modules:
    Data.Json.Internal.Parser

  build-depends:
    base,
    megaparsec,
    text

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests

  type: exitcode-stdio-1.0
  main-is: Spec.hs

  ghc-options: -Wall

  other-modules:
    Test.Data.Json.Internal.ParserSpec

  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    hspec,
    hspec-megaparsec,
    internal,
    megaparsec,
    text

  build-tool-depends:
    hspec-discover:hspec-discover
