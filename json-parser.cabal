cabal-version: 3.0

name: json-parser
version: 0.1.0.0

synopsis: A JSON parser compliant with RFC 8259
description:
  A JSON parser compliant with <https://www.rfc-editor.org/info/rfc8259/ RFC 8259>. It parses JSON values into a Haskell data structure.

  A pretty printer is also provided for producing nicely formatted JSON values.

license: BSD-3-Clause
license-file: LICENSE

author: Dwayne Crooks
maintainer: maintainer@dwaynecrooks.com

category: JSON, Parser, Pretty Printer

extra-doc-files:
  README.md

source-repository head
  type: git
  location: https://github.com/dwayne/hs-json-parser

library
  default-language: Haskell2010
  hs-source-dirs: src

  ghc-options: -Wall

  exposed-modules:
    Json

    --
    -- These internal modules are exposed so I can test their implementation details.
    --
    Internal.Json
    Internal.Parser
    Internal.Printer

  build-depends:
    base ^>=4.20,
    bytestring ^>=0.12,
    megaparsec ^>=9.7,
    scientific ^>=0.3,
    text ^>=2.1

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests
  main-is: Spec.hs
  type: exitcode-stdio-1.0

  ghc-options: -Wall

  other-modules:
    Test.Internal.ParserSpec
    Test.Internal.PrinterSpec

  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    hspec,
    hspec-megaparsec,
    json-parser,
    megaparsec,
    text

  build-tool-depends:
    hspec-discover:hspec-discover
