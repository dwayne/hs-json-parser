cabal-version: 3.0

name: json-parser
version: 0.1.0.0

library
  default-language: Haskell2010
  hs-source-dirs: src

  ghc-options: -Wall

  exposed-modules:
    Json.Parser

  build-depends:
    base,
    megaparsec,
    text

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests

  type: exitcode-stdio-1.0
  main-is: Spec.hs

  ghc-options: -Wall

  other-modules:
    Test.Json.ParserSpec

  build-depends:
    base,
    hspec,
    hspec-megaparsec,
    json-parser,
    megaparsec,
    text

  build-tool-depends:
    hspec-discover:hspec-discover
