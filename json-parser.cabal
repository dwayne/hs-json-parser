cabal-version: 3.0

name: json-parser
version: 0.1.0.0

library
  default-language: Haskell2010
  hs-source-dirs: src

  ghc-options: -Wall

  exposed-modules:
    Data.Json

  build-depends:
    base ^>=4.20,
    bytestring ^>=0.12,
    internal,
    megaparsec ^>=9.7,
    scientific ^>=0.3,
    text ^>=2.1

library internal
  default-language: Haskell2010
  hs-source-dirs: lib

  ghc-options: -Wall

  exposed-modules:
    Internal.Data.Json
    Internal.Text.Parser
    Internal.Text.Printer

  build-depends:
    base ^>=4.20,
    megaparsec ^>=9.7,
    text ^>=2.1

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests
  main-is: Spec.hs
  type: exitcode-stdio-1.0

  ghc-options: -Wall

  other-modules:
    Test.Internal.Text.ParserSpec
    Test.Internal.Text.PrinterSpec

  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    hspec,
    hspec-megaparsec,
    internal,
    megaparsec,
    text

  build-tool-depends:
    hspec-discover:hspec-discover
